# ==============================================================================
# BACKEND ENVIRONMENT SWITCH: 'prod' (Remote Worker) or 'dev' (Local Server)
# Change this single variable to switch backends seamlessly!
# ==============================================================================
BACKEND_MODE=dev
NEXT_PUBLIC_BACKEND_MODE=dev

# Remote Cloudflare Worker API URL (Used when BACKEND_MODE=prod)
REMOTE_API_URL=https://aetheroll.shivareddyvanja.workers.dev
NEXT_PUBLIC_REMOTE_API_URL=https://aetheroll.shivareddyvanja.workers.dev

# Telegram MTProto Configuration
# Obtain from https://my.telegram.org (API development tools)
TELEGRAM_API_ID=33733965
TELEGRAM_API_HASH=5480555d3582640829f62d06a0d47411

# Set to true if connecting to Telegram test DCs (test server)
TELEGRAM_TEST_MODE=false

# Optional: Custom DC IP and Port if using specific DC proxies
TELEGRAM_DC_IP=149.154.167.40:443
TELEGRAM_DC_PORT=443

# Security & Encryption (Generate random 32-byte hex strings)
SESSION_ENCRYPTION_KEY=replace_with_32_byte_hex_secret_key_for_aes_256
JWT_SECRET=replace_with_random_jwt_secret_token

# Cloudflare D1 & R2 (For local development, SQLite fallback and local R2 emulation are used)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET_NAME=aetheroll-media
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
