# ==============================================================================
# Aetheroll Web Frontend Configuration (.env.example)
# ==============================================================================

# 1. Backend Mode:
#    - 'prod'  : Connect to remote Cloudflare Worker API & D1 database (Production mode)
#    - 'local' : Run standalone with internal Node.js API routes & local SQLite (Development/Testing)
NEXT_PUBLIC_BACKEND_MODE=prod

# 2. Remote Worker API URL (Required when NEXT_PUBLIC_BACKEND_MODE=prod):
NEXT_PUBLIC_REMOTE_API_URL=https://aetheroll-api.yourdomain.com

# 3. Canonical Website URL (Used for SEO, OpenGraph image generation, and sitemaps):
NEXT_PUBLIC_SITE_URL=https://aetheroll.app

# 4. Optional: Google Search Console Verification Code:
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_verification_token_here
